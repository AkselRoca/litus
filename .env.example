# Contact — variables serveur uniquement. Aucune clé réelle dans ce fichier.
# Copier les valeurs requises dans .env.local et dans Vercel (Preview / Production).
RESEND_API_KEY=
# Adresse SEULE (sans nom d'affichage), sur un domaine vérifié dans Resend.
# Exemple de format, à remplacer par VOTRE domaine réellement vérifié :
RESEND_FROM_EMAIL=contact@notifications.votre-domaine.fr
# Destinataire fixé dans le code : litusagency@gmail.com. Aucun CONTACT_TO.

# Stockage antispam partagé : utiliser Upstash, ou les variables Turso déjà
# configurées plus bas. Une seule des deux solutions est nécessaire.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Secret aléatoire de 32 caractères minimum pour hacher IP et demandes.
CONTACT_HASH_SECRET=
# Isoler dev/preview/prod ; même préfixe et secret sur toutes les instances de prod.
CONTACT_REDIS_PREFIX=litus:contact:development:v1
CONTACT_RATE_IP_LIMIT=5
CONTACT_RATE_IP_WINDOW_SECONDS=900
CONTACT_RATE_GLOBAL_LIMIT=30
CONTACT_RATE_GLOBAL_WINDOW_SECONDS=60
# Origines EXACTES, séparées par virgule, sans slash final. HTTPS exigé en prod.
CONTACT_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Vercel : laisser vide, x-vercel-forwarded-for est utilisé automatiquement.
# Autre hébergeur : nom d'un header écrasé par votre reverse proxy de confiance.
# L'application ne doit pas être accessible en contournant ce proxy.
CONTACT_TRUSTED_IP_HEADER=

# CRM existant : local SQLite ; production : base Turso partagée.
DATABASE_URL=file:./dev.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Editorial automation (server only, production). Existing Gemini/DataForSEO/Cloudinary accounts.
EDITORIAL_ENABLED=false
EDITORIAL_MODEL=gemini-2.5-flash
CRON_SECRET=
GEMINI_API_KEY=
DATAFORSEO_LOGIN=
DATAFORSEO_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Only for isolated automated tests. Production uses the shared Turso database.
EDITORIAL_DATABASE_URL=
