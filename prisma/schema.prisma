// This is your Prisma schema file
// Schema validé dans l'ADD (Architecture Decision Document)

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Admin users (Aksel + Arthur)
model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  password           String   // Hashed avec bcrypt
  name               String
  role               String   @default("admin") // admin, commercial, dev
  avatar             String?  // URL de la photo de profil
  emailNotifications Boolean  @default(true)
  
  // Relations
  assignedLeads      Lead[]   @relation("AssignedTo")
  
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// Leads (CRM)
model Lead {
  id             String   @id @default(cuid())
  type           String   // "contact" | "audit" | "cartographie" | "guide" | "estimateur"
  email          String?
  phone          String?
  data           String   // JSON stringifié - données du formulaire
  source         String   // Page d'origine
  
  // CRM fields
  status         String   @default("new") // new, contacted, quote_sent, signed, refused
  oneShot        Float?   // Montant one-shot (€)
  monthlyAmount  Float?   // Montant mensuel (€)
  contractMonths Int?     // Durée contrat en mois
  notes          String?  // Notes internes
  
  // Assignation
  assignedToId   String?
  assignedTo     User?    @relation("AssignedTo", fields: [assignedToId], references: [id])
  
  // Legacy (pour compatibilité)
  treated        Boolean  @default(false)
  
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([assignedToId])
  @@index([createdAt])
  @@index([treated])
}

// Articles de blog
model BlogPost {
  id          String    @id @default(cuid())
  slug        String    @unique
  title       String
  excerpt     String
  content     String    // MDX content
  metaTitle   String?   // SEO meta title
  metaDesc    String?   // SEO meta description
  published   Boolean   @default(false)
  publishedAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([slug])
  @@index([published])
  @@index([publishedAt])
}

// Configuration globale (badge dispo, etc.)
model Config {
  id    String  @id @default("main")
  dispo Boolean @default(true) // Badge "Dispo projet" dans header
}

// Données Estimateur de Potentiel (pré-calculées)
// Note: Pour MVP, on peut aussi utiliser un JSON statique
model EstimatorData {
  id               String @id @default(cuid())
  metier           String
  ville            String
  searchesPerMonth Int    // Volume recherches Google
  avgBasket        Int    // Panier moyen en euros

  @@unique([metier, ville])
  @@index([metier])
  @@index([ville])
}

// Tracking téléchargements lead magnets
model LeadMagnetDownload {
  id        String   @id @default(cuid())
  type      String   // "guide-collectivites" | etc.
  email     String?
  source    String   // Page d'origine
  createdAt DateTime @default(now())

  @@index([createdAt])
}

// Portfolio Projects
model Project {
  id          String   @id @default(cuid())
  title       String
  description String
  categories  String   // JSON string: ["Site Vitrine", "Google Ads", "SEO"]
  imageUrl    String
  link        String?
  stats       String   // JSON string: [{ label: "ROI", value: "+200%" }]
  tags        String   // JSON string: ["Next.js", "Shopify"]
  featured    Boolean  @default(false) // Pour afficher sur la home/services
  order       Int      @default(0)     // Ordre d'affichage
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([featured])
}

// Media Library (Cloudinary)
model Media {
  id        String   @id @default(cuid())
  publicId  String   @unique // Cloudinary public_id
  url       String            // URL originale Cloudinary
  filename  String            // Nom du fichier original
  alt       String?           // Texte alternatif
  width     Int?
  height    Int?
  format    String?           // jpg, png, webp
  bytes     Int?              // Taille en bytes
  folder    String  @default("litus") // Dossier Cloudinary
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([folder])
  @@index([createdAt])
}

// Page views tracking (custom analytics)
model PageView {
  id        String   @id @default(cuid())
  path      String   // URL path visited
  referrer  String?  // Source of traffic
  userAgent String?  // Browser/device info
  country   String?  // Country from IP (optional)
  sessionId String?  // Anonymous session identifier
  createdAt DateTime @default(now())

  @@index([path])
  @@index([createdAt])
  @@index([sessionId])
}

// Web Vitals tracking (LCP, FID, CLS)
model WebVital {
  id        String   @id @default(cuid())
  name      String   // LCP, FID, CLS, TTFB, FCP
  value     Float    // Metric value
  rating    String   // good, needs-improvement, poor
  path      String   // Page where measured
  sessionId String?  // Anonymous session identifier
  createdAt DateTime @default(now())

  @@index([name])
  @@index([createdAt])
  @@index([rating])
}
